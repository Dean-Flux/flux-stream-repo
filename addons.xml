<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="repository.fluxstream" name="Flux Stream Repository" version="1.0.0" provider-name="Dean-Flux">
  <extension point="xbmc.addon.repository" name="Flux Stream Repository">
    <dir minversion="21.0.0">
      <info compressed="false">https://dean-flux.github.io/flux-stream-repo/addons.xml</info>
      <checksum>https://dean-flux.github.io/flux-stream-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://dean-flux.github.io/flux-stream-repo/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Flux Stream updates for Kodi 21 and newer</summary>
    <description lang="en_GB">Installs and updates Flux Stream through Kodi's add-on manager. CocoScrapers is installed separately. Trakt currently uses an owner/tester development application.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/Dean-Flux/flux-stream-repo</source>
  </extension>
</addon><addon id="plugin.video.personalstream" name="Flux Stream" version="0.3.15" provider-name="Flux Stream (based on Jacktook by Sam-Max)">
  <requires>
    <import addon="skin.fluxstream" version="1.0.1" />
    <import addon="xbmc.python" version="3.0.1" />
    <import addon="script.module.requests" version="2.25.1" />
    <import addon="script.module.routing" version="0.2.3" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="jacktook.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.python.module" library="lib" />
  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <summary lang="en">TorBox, CocoScrapers, and Trakt for Kodi</summary>
    <description lang="en">Personal streaming foundation based on Jacktook, with TMDB metadata, CocoScrapers discovery, TorBox playback, and Trakt tracking.</description>
    <license>GPL-2.0-only</license>
    <assets>
      <icon>resources/branding/flux-icon.png</icon>
      <fanart>resources/branding/flux-fanart.png</fanart>
    </assets>
 </extension>
